{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "医疗产品进销存",
  "version": "0.1.0",
  "identifier": "com.local.medical-inventory",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:6173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "医疗产品进销存",
        "width": 1480,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
